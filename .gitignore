# environment files (real values stay local; .env.example is the template)
.env
.env.*
!.env.example

# virtual env / Python caches
venv/
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# IDE / OS junk
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# logs
*.log

# raw footage / media (large, not code)
*.mp4
*.mov
*.heic
*.HEIC

# datasets (images/labels - large, regenerable from footage + labeling scripts)
yolo_dataset/
yolo_dataset_v4*/
# also matches when yolo_dataset_v4 (or a *_color/*_mono variant) is a symlink
# (e.g. -> shipcaps_remote/_dataset, a shared folder on the rig) - a trailing-slash
# pattern alone does not match a symlink even if it points at a directory.
yolo_dataset_v4*
external_runs/
calibration_frames/
calibration_v2/
calibrationLazerMeasurements/
thumbnails/
review_*/
teknedenTekneyeGörüntü/
yeniTrain/
zirazF3W
zitZ23ZM

# training run artifacts (checkpoints/plots/logs) - curated best.pt files live in weights/ instead
runs/
runs_boat_yolo/
results/

# packaged bundles sent to/from Colab, and pretrained base weights (re-downloadable)
*.zip
yolov8n.pt
yolov8s.pt
yolo11s.pt
yolo11m.pt
shipcaps_remote/
shipcaps1_remote/
.rclone-mount*.log
