# Copy to .env and fill in only what differs from the defaults.
# Nothing loads this file automatically: export it into your shell first,
#   set -a; source .env; set +a
# Empty values fall back to the default shown in each comment.
# Offline work (run.py on a video file, tests, pool_sim.py, tma_sim.py, the viewer)
# needs none of these; they only matter when talking to the rigs.

# --- Rig connection (scripts/*.sh, track_target.py) ---
# ShipCam IP: HTTP control API on :8080 and ssh as root. Default 192.168.1.104 (ShipCam0);
# ShipCam1 is 192.168.1.107.
RIG=
# ssh target used by scripts/process_on_rig.sh. Default root@192.168.1.104
RIG_HOST=
# Private ssh key authorized on the rigs. Default ~/.ssh/id_ed25519_shipcam
RIG_KEY=
# MQTT broker carrying UWB/IMU telemetry (rig_state_logger.py, rig_state_producer.py,
# scripts/capture_session.sh). Port 1883, no authentication. Default 192.168.1.110
BROKER=

# --- Local paths ---
# Checkout of the hydrolink repository; track_target.py reads camera intrinsics from
# <HYDROLINK_DIR>/ship_camera_processing/calib/. Default ~/Documents/hydrolink
HYDROLINK_DIR=
# Detector used by scripts/process_on_rig.sh. Default weights/boat_v4_s_best.pt
WEIGHTS=

# --- Optional third-party settings ---
# Hugging Face cache for the Depth Anything V2 model (public, no token required).
# HF_HOME=
# HF_TOKEN=
# Ultralytics settings directory.
# YOLO_CONFIG_DIR=
# scripts/train_loop.sh retry budget. Default 3
# MAX_RETRIES=
